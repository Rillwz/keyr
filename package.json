{
  "name": "keyr",
  "version": "1.0.0",
  "description": "Keyr - personal secret manager CLI, self-hosted, terenkripsi di komputer Anda sendiri",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "keyr": "src/index.js"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "build": "node scripts/build-ui.js",
    "deploy:site": "npx wrangler pages deploy site/dist --project-name=keyr",
    "prepare": "npm run build",
    "ui": "node src/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cli",
    "secrets",
    "password-manager",
    "encryption",
    "aes-256-gcm"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "gradient-string": "^2.0.2",
    "ink": "^5.1.0",
    "ink-select-input": "^6.0.0",
    "ink-text-input": "^6.0.0",
    "ora": "^8.1.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4.0.0"
  }
}
